{
  "schemaVersion": 1,
  "id": "limitedlives",
  "version": "${mod_version}",

  "name": "Limited Lives",
  "description": "${mod_description}",
  "authors": [
    "iChun"
  ],
  "contact": {
    "homepage": "${mod_url_home}",
    "sources": "${mod_url_sources}",
    "issues": "${mod_url_issues}"
  },

  "license": "${mod_license}",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "me.ichun.mods.limitedlives.loader.fabric.LoaderFabric"
    ],
    "modmenu": [
      "me.ichun.mods.limitedlives.loader.fabric.client.ModMenuIntegration"
    ]
  },

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${mod_url_discord}"
      }
    }
  },

  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": ">=1.20.6 <1.21",
    "java": ">=21",
    "ichunutil": ">=1.0.0"
  }
}
